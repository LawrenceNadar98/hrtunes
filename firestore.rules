rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == "instructor" ||
        request.auth.token.role == "admin"
      );
    }

    // 1. Users collection: Users can read and update their own document
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) &&
         // Ordinary students cannot self-grant admin or active subscription status
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'enrolledPlanId', 'enrollmentStatus']))
      );
    }

    // 2. Public Catalog Collections (Plans, Courses, Curriculum)
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /curriculum/{curriculumId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Trial Bookings
    match /trialBookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Enrollments: CRITICAL SECURITY BARRIER
    // Students can read their own enrollments.
    // Students can create pending enrollment records for manual UPI flow.
    // Students CANNOT set status to "active" directly from client!
    // Active enrollment is granted exclusively by trusted server (Firebase Admin SDK).
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Students can only create pending enrollments
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid &&
         request.resource.data.status == "pending")
      );
      // Only Admin / Server can update enrollment status to active
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Payments: CRITICAL SECURITY BARRIER
    // Students can submit payment records with status == "pending" (manual UPI).
    // Students CANNOT set status to "verified" directly from client!
    // Verification is executed by server (Razorpay verification) or Instructor approval.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Allow creation of pending UPI proof records
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid &&
         request.resource.data.status == "pending")
      );
      // Status update from pending -> verified is forbidden for ordinary students
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
